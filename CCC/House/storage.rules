rules_version = '2';

// Firebase Storage security rules for project `japan-2026-apr` (U30 receipts).
//
// This is the canonical, version-controlled copy — SEPARATE from firestore.rules
// (Storage and Firestore have different rule files). There is no Firebase CLI in
// this project, so it is not deployed automatically: paste this into the Firebase
// console → Storage → Rules, then Publish.
//
// Before pasting, replace the placeholder emails with the same real accounts
// used in firestore.rules (created under Authentication → Users). These must be
// the accounts that will upload receipts.
//
// The boundary encoded:
//   - Receipts are world-READABLE (public), matching the decision that the
//     download-token URL is stored on the public-read expense doc. In practice
//     the token URL is already a shareable capability.
//   - Only a signed-in family account may WRITE, and only images or PDFs under
//     10 MB — so a stray or hostile upload cannot fill the bucket.
//   - Anything outside house-receipts/** is denied by default.

service firebase.storage {
  match /b/{bucket}/o {
    match /house-receipts/{expId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
             'jiten@example.com',
             'priyanuj@example.com'
           ]
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
